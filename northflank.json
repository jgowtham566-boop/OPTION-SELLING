{
  "apiVersion": "v1.2",
  "name": "Optopsy Option Selling",
  "description": "Optopsy Option Selling & Backtesting Chat UI deployed on Northflank",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "option-selling",
            "region": "europe-west",
            "color": "#17b9ff",
            "description": "Optopsy Option Selling & Backtesting Project"
          }
        },
        {
          "kind": "CombinedService",
          "ref": "option-selling-service",
          "spec": {
            "name": "option-selling-ui",
            "description": "Optopsy Options Strategy Backtesting & AI Chat UI",
            "billing": {
              "deploymentPlan": "nf-compute-20",
              "buildPlan": "nf-compute-200-8"
            },
            "vcsData": {
              "projectUrl": "https://github.com/jgowtham566-boop/OPTION-SELLING",
              "branch": "main"
            },
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "buildkit",
                "dockerFilePath": "/Dockerfile",
                "dockerWorkDir": "/"
              }
            },
            "deployment": {
              "instances": 1
            },
            "ports": [
              {
                "name": "http",
                "port": 8000,
                "protocol": "HTTP",
                "public": true
              }
            ],
            "healthChecks": [
              {
                "type": "readinessProbe",
                "protocol": "HTTP",
                "port": 8000,
                "path": "/health",
                "initialDelaySeconds": 15,
                "periodSeconds": 15,
                "timeoutSeconds": 5,
                "failureThreshold": 3
              },
              {
                "type": "livenessProbe",
                "protocol": "HTTP",
                "port": 8000,
                "path": "/health",
                "initialDelaySeconds": 30,
                "periodSeconds": 20,
                "timeoutSeconds": 5,
                "failureThreshold": 3
              }
            ]
          }
        }
      ]
    }
  }
}
